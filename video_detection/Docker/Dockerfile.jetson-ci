# Dockerfile optimized for GitHub Actions ARM64 emulation builds
# This version uses more pre-compiled packages to avoid compilation issues
FROM arm64v8/ubuntu:20.04 AS base

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    python3-setuptools \
    python3-wheel \
    python3-numpy \
    python3-scipy \
    python3-opencv \
    python3-matplotlib \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgstreamer1.0-0 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    libgstreamer-plugins-base1.0-0 \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    v4l-utils \
    pkg-config \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create symlink for python
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Stage 2: Application setup
FROM base AS app

# Create app user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Set working directory
WORKDIR /video_detection

# Copy requirements first for better caching
COPY requirements.txt pyproject.toml ./

# Install Python dependencies - use system packages where possible
RUN python3 -m pip install --upgrade pip setuptools wheel && \
    # Install only packages not available as system packages
    pip3 install --no-cache-dir \
    flask \
    pyzmq \
    python-dotenv \
    lap \
    # Install PyTorch CPU version for ARM64
    && pip3 install --no-cache-dir \
    torch==1.13.* \
    torchvision==0.14.* \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    # Install ultralytics with minimal dependencies
    && pip3 install --no-cache-dir "ultralytics>=8.1.0" --no-deps \
    && pip3 install --no-cache-dir \
    pillow \
    pyyaml \
    requests \
    tqdm

# Copy application code
COPY --chown=appuser:appuser . .

# Create necessary directories
RUN mkdir -p /video_detection/static /video_detection/Snapshots && \
    chown -R appuser:appuser /video_detection

# Download YOLO model if not present
RUN if [ ! -f "yolo11n-seg.pt" ]; then \
    wget -O yolo11n-seg.pt https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n-seg.pt; \
    fi

# Switch to non-root user
USER appuser

# Health check (longer intervals for ARM emulation)
HEALTHCHECK --interval=60s --timeout=30s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:8082/api/status || exit 1

# Expose port
EXPOSE 8082 5555 5556

# Set default environment variables
ENV FLASK_RUN_HOST=0.0.0.0 \
    FLASK_RUN_PORT=8082 \
    DETECTION_IMAGE_ENDPOINT="tcp://*:5555" \
    DETECTION_RESULTS_ENDPOINT="tcp://*:5556"

# Run the application
ENTRYPOINT ["python3", "app.py"]
